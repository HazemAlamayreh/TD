rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Admin identities must be provisioned in Firebase Console or trusted server.
    // Never allow the browser to create or edit its own admin role.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }
    match /admins/{uid} {
      allow get: if isOwner(uid);
      allow list, create, update, delete: if false;
    }
    // Employee directory is provisioned exclusively by trusted Cloud Functions.
    // Admins can inspect directory entries but cannot edit identifiers in-browser.
    match /employees/{employeeId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if false;
    }
    // Rate-limit counters are managed only via Firebase Admin SDK.
    match /employeeRequestLimits/{key} {
      allow read, write: if false;
    }
    match /learners/{uid} {
      allow get, list: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid);
      allow delete: if false;
      match /lessonProgress/{id} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }
      match /lessonMastery/{id} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }
      // Foreground activity counters: each learner owns their own records.
      // Administrators can read aggregate usage but cannot modify it.
      match /activity/{id} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }
      match /sync/{id} {
        allow get, list: if isOwner(uid);
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }
      match /assessmentAttempts/{id} {
        allow get, list: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid);
        allow delete: if false;
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}